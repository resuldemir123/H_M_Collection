@{
    ViewData["Title"] = "İletişim";
}

<div class="hero mb-4" data-aos="fade-up">
    <span class="accent-badge mb-2">Bize Ulaşın</span>
    <h2 class="mb-2">Sorularınız için buradayız</h2>
    <p class="mb-0">Size en kısa sürede dönüş yapıyoruz.</p>
</div>

<div class="row g-3">
    <div class="col-md-6" data-aos="fade-right">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">İletişim Bilgileri</h5>
                <p class="mb-1">E-posta: <a href="mailto:info@hmcollection.local">info@hmcollection.local</a></p>
                <p class="mb-1">Telefon: 0 (555) 555 55 55</p>
                <p class="text-muted">Çalışma saatleri: 09:00 - 18:00</p>
            </div>
        </div>
    </div>
    <div class="col-md-6" data-aos="fade-left">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Adres</h5>
                <p class="mb-2">H M Collection Showroom</p>
                <p class="text-muted mb-0">İstanbul, Türkiye</p>
            </div>
        </div>
    </div>
</div>

<div class="mt-4" data-aos="fade-up">
    <div class="card">
        <div class="card-body p-2 p-md-3">
            <div class="ratio ratio-16x9">
                <iframe
                    src="https://www.google.com/maps?hl=tr&q=https://maps.app.goo.gl/cU4G3FP9ZGWpNpP56&z=16&output=embed"
                    style="border:0;" allowfullscreen="" loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        </div>
    </div>
    <div class="form-text mt-2">Konum temsili olarak eklenmiştir; isterseniz işletmenizin koordinatlarını güncelleyebilirim.</div>
</div>


