@{
    ViewData["Title"] = "Hakkımızda - H M Collection";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="hero-content text-center">
            <span class="hero-badge">Hikayemiz</span>
            <h1 class="hero-title">Kaliteye Olan <br>Tutkumuz</h1>
            <p class="hero-subtitle">2018'den beri zarafet ve kaliteyi <br>bir araya getiriyoruz</p>
        </div>
    </div>
</section>

<!-- About Content -->
<section class="section">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6" data-aos="fade-right">
                <h2 class="display-5 fw-bold mb-4">Hikayemiz ve <span class="text-gradient">Değerlerimiz</span></h2>
                <p class="lead mb-4">
                    HM Collection olarak, 2018 yılından bu yana müşterilerimize en kaliteli ve şık ürünleri
                    sunmak için çalışıyoruz. Her bir ürün, uzman ekibimiz tarafından özenle seçilmekte ve
                    siz değerli müşterilerimize ulaştırılmaktadır.
                </p>
                <p class="mb-4">
                    Misyonumuz, sadece ürün satmak değil, aynı zamanda unutulmaz bir alışveriş deneyimi
                    yaşatmaktır. Kalite, güven ve müşteri memnuniyeti bizim için her zaman öncelikli
                    değerler olmuştur.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <div class="text-center">
                        <div class="fs-2 fw-bold text-brand">6+</div>
                        <div class="text-muted">Yıllık Deneyim</div>
                    </div>
                    <div class="text-center">
                        <div class="fs-2 fw-bold text-brand">500+</div>
                        <div class="text-muted">Mutlu Müşteri</div>
                    </div>
                    <div class="text-center">
                        <div class="fs-2 fw-bold text-brand">%99</div>
                        <div class="text-muted">Memnuniyet</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6" data-aos="fade-left">
                <div class="border-radius-lg overflow-hidden shadow-soft">
                    <img src="https://images.unsplash.com/photo-1607082348824-0a96f2a4b9da?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80"
                         alt="HM Collection Showroom" class="img-fluid">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Values Section -->
<section class="section section-alt">
    <div class="container">
        <h2 class="section-title">Değerlerimiz</h2>
        <div class="row g-4">
            <div class="col-md-4" data-aos="fade-up">
                <div class="text-center p-4">
                    <div class="icon-wrapper bg-brand-extra-light text-brand rounded-circle mx-auto mb-3"
                         style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-gem fa-2x"></i>
                    </div>
                    <h5 class="fw-semibold mb-3">Kalite</h5>
                    <p class="text-muted mb-0">
                        Her ürünümüz en yüksek kalite standartlarında, özenle seçilmiş ve test edilmiştir.
                    </p>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="text-center p-4">
                    <div class="icon-wrapper bg-brand-extra-light text-brand rounded-circle mx-auto mb-3"
                         style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-handshake fa-2x"></i>
                    </div>
                    <h5 class="fw-semibold mb-3">Güven</h5>
                    <p class="text-muted mb-0">
                        Müşterilerimizin güveni bizim için her şeyden önemlidir. Şeffaf ve güvenilir ilişkiler kuruyoruz.
                    </p>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="text-center p-4">
                    <div class="icon-wrapper bg-brand-extra-light text-brand rounded-circle mx-auto mb-3"
                         style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-heart fa-2x"></i>
                    </div>
                    <h5 class="fw-semibold mb-3">Memnuniyet</h5>
                    <p class="text-muted mb-0">
                        Müşteri memnuniyeti odaklı çalışıyor, her detayı düşünerek hizmet veriyoruz.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>