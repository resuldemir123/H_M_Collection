@{
    ViewData["Title"] = "Hakkımda";
}

<div class="hero mb-4" data-aos="fade-up">
    <span class="accent-badge mb-2">Hikayemiz</span>
    <h2 class="mb-2">Özen, Zarafet ve Güven</h2>
    <p class="mb-0">Kaliteye olan bağlılığımız; seçkideki her ürüne yansır.</p>
 </div>

<div class="row g-3">
    <div class="col-md-4" data-aos="fade-right">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Misyon</h5>
                <p class="card-text">Müşterilerimize seçkin, zamansız ve kaliteli ürünleri ulaştırmak.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4" data-aos="fade-up">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Vizyon</h5>
                <p class="card-text">Zarafetin ilk akla geldiği marka olmak ve ilham vermek.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4" data-aos="fade-left">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Değerler</h5>
                <p class="card-text">Güven, şeffaflık, sürdürülebilirlik ve müşteri memnuniyeti.</p>
            </div>
        </div>
    </div>
</div>


