@{
 ViewData["Title"] = "Test E-Posta - Admin";
}

<div class="container mt-5">
 <h3>Test E-Posta Gönder</h3>
 @if (TempData["AdminMsg"] != null)
 {
 <div class="alert alert-info">@TempData["AdminMsg"]</div>
 }
 <form asp-action="TestEmail" method="post" class="mt-3">
 @Html.AntiForgeryToken()
 <div class="mb-3">
 <label class="form-label">Alýcý E-Posta</label>
 <input type="email" name="to" class="form-control" placeholder="test@domain.com" required />
 </div>
 <div class="mb-3">
 <label class="form-label">Konu</label>
 <input type="text" name="subject" class="form-control" placeholder="Test Konusu" />
 </div>
 <div class="mb-3">
 <label class="form-label">Mesaj</label>
 <textarea name="body" class="form-control" rows="4">Bu bir test mesajýdýr.</textarea>
 </div>
 <button type="submit" class="btn btn-primary">Gönder</button>
 </form>
</div>