@{
    ViewData["Title"] = "Müşteri Memnuniyeti - H M Collection";
}

<!-- Hero Section -->
<section class="hero-section">
 <div class="container">
 <div class="hero-content text-center">
 <span class="hero-badge">Memnuniyet</span>
 <h1 class="hero-title">Müşteri Memnuniyeti</h1>
 <p class="hero-subtitle">Süreçlerimizi yorumlarınıza göre sürekli iyileştiriyoruz</p>
 </div>
 </div>
</section>

<!-- Photo/Video Upload Section -->
<section class="section section-alt">
 <div class="container">
 <div class="row justify-content-center">
 <div class="col-lg-8">
 <div class="card border-0 shadow-soft">
 <div class="card-body p-4 p-md-5">
 <h3 class="text-center mb-4">Fotoğraf / Video Paylaşın</h3>
 @if (TempData["Message"] != null)
 {
 <div class="alert alert-info alert-dismissible fade show" role="alert">
 @TempData["Message"]
 <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
 </div>
 }
 <form asp-action="UploadSatisfactionPhoto" method="post" enctype="multipart/form-data">
 <div class="row g-3 align-items-end">
 <div class="col-md-6">
 <label class="form-label fw-semibold">Dosya Seçin (Fotoğraf veya Video)</label>
 <input type="file" name="file" class="form-control" accept="image/*,video/*" required />
 </div>
 <div class="col-md-4">
 <label class="form-label fw-semibold">Açıklama</label>
 <input type="text" name="caption" class="form-control" placeholder="İsteğe bağlı" />
 </div>
 <div class="col-md-2">
 <button class="btn btn-primary w-100" type="submit">
 <i class="fas fa-upload me-1"></i>Yükle
 </button>
 </div>
 </div>
 @Html.AntiForgeryToken()
 </form>
 </div>
 </div>
 </div>
 </div>
 </div>
</section>

<!-- Gallery Section -->
<section class="section section-alt">
 <div class="container">
 <h2 class="section-title text-center">Paylaşılan Medya</h2>
 @{
 var photos = (System.Collections.Generic.List<H_M_Collection.Models.Photo>)ViewBag.Photos;
 }
 @if (photos != null && photos.Any())
 {
 <div class="row g-4">
 @foreach (var p in photos)
 {
 var ext = System.IO.Path.GetExtension(p.FileName).ToLowerInvariant();
 var isVideo = new[] { ".mp4", ".webm" }.Contains(ext);
 <div class="col-6 col-md-4 col-lg-3" data-aos="zoom-in">
 <div class="card border-0 shadow-soft h-100">
 @if (isVideo)
 {
 <video controls style="width:100%; height:250px; object-fit:cover;">
 <source src="@Url.Content($"~/uploads/{p.FileName}")" type="video/mp4" />
 Your browser does not support the video tag.
 </video>
 }
 else
 {
 <img class="card-img-top" src="@Url.Content($"~/uploads/{p.FileName}")" alt="@p.Caption" style="height:250px; object-fit: cover;">
 }
 @if (!string.IsNullOrWhiteSpace(p.Caption))
 {
 <div class="card-body">
 <p class="card-text small mb-0 text-center">@p.Caption</p>
 </div>
 }
 </div>
 </div>
 }
 </div>
 }
 else
 {
 <div class="text-center py-5">
 <i class="fas fa-images fa-3x text-muted mb-3"></i>
 <p class="text-muted">Henüz medya paylaşılmadı</p>
 </div>
 }
 </div>
</section>