<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - H M Collection</title>
    <meta name="description" content="H M Collection - Zarafet ve kalitenin buluşma noktası. Premium ürünler ve olağanüstü müşteri deneyimi.">
    <meta name="theme-color" content="#1a237e" />

    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <!-- Styles -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/H_M_Collection.styles.css" asp-append-version="true" />
    <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet">
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="fas fa-crown me-2"></i>HM Collection
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Anasayfa</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="About">Hakkımızda</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Satisfaction">Memnuniyet</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Contact">İletişim</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow-1">
        <!-- Padding for fixed navbar -->
        <div style="padding-top: 80px;">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="footer mt-auto">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h5 class="mb-3">
                        <i class="fas fa-crown me-2"></i>HM Collection
                    </h5>
                    <p class="opacity-75">Zarafet ve kalitenin buluşma noktası. Size özel seçkilerimizle hayatınıza değer katıyoruz.</p>
                </div>
                <div class="col-lg-2">
                    <h6 class="mb-3">Bağlantılar</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Index">Anasayfa</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="About">Hakkımızda</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Satisfaction">Memnuniyet</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">İletişim</a></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h6 class="mb-3">İletişim</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="fas fa-envelope me-2"></i>
                            info@hmcollection.com
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-phone me-2"></i>
                            +90 (555) 123 45 67
                        </li>
                        <li>
                            <i class="fas fa-map-marker-alt me-2"></i>
                            İstanbul, Türkiye
                        </li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h6 class="mb-3">Sosyal Medya</h6>
                    <div class="d-flex gap-3">
                        <a href="#" class="text-white opacity-75">
                            <i class="fab fa-instagram fa-lg"></i>
                        </a>
                        <a href="#" class="text-white opacity-75">
                            <i class="fab fa-facebook fa-lg"></i>
                        </a>
                        <a href="#" class="text-white opacity-75">
                            <i class="fab fa-twitter fa-lg"></i>
                        </a>
                        <a href="#" class="text-white opacity-75">
                            <i class="fab fa-pinterest fa-lg"></i>
                        </a>
                    </div>
                </div>
            </div>
            <hr class="my-4 opacity-25">
            <div class="text-center opacity-75">
                <small>&copy; 2024 H M Collection. Tüm hakları saklıdır.</small>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
    <script>
        // Initialize AOS
        AOS.init({
            duration: 800,
            easing: 'ease-out-quad',
            once: true,
            offset: 50
        });

        // Navbar scroll effect
        window.addEventListener('scroll', function () {
            const navbar = document.querySelector('.navbar');
            if (window.scrollY > 100) {
                navbar.style.boxShadow = '0 2px 20px rgba(0,0,0,0.1)';
            } else {
                navbar.style.boxShadow = 'none';
            }
        });

        // Ensure footer stays at bottom
        document.addEventListener('DOMContentLoaded', function () {
            const body = document.body;
            const main = document.querySelector('main');
            const footer = document.querySelector('.footer');

            function adjustLayout() {
                const windowHeight = window.innerHeight;
                const bodyHeight = body.scrollHeight;

                if (bodyHeight < windowHeight) {
                    main.style.minHeight = `calc(100vh - ${footer.offsetHeight}px - 80px)`;
                }
            }

            adjustLayout();
            window.addEventListener('resize', adjustLayout);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>